[Unit]
Description=DeckIDE shared Chrome (desktop + agents, CDP 127.0.0.1:9222)
Requires=deckide-desktop.service
After=deckide-desktop.service
PartOf=deckide-desktop.service
Before=deckide.service

[Service]
Type=simple
User=root
Group=root
Environment=DECKIDE_DESKTOP_DISPLAY=:99
Environment=DECKIDE_DESKTOP_XAUTHORITY=/run/deckide-desktop/Xauthority
ExecStart=/usr/local/lib/deckide-desktop/browser.sh
KillMode=control-group
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
